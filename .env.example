# Environment and application
APP_NAME=Kaituhi Korero
APP_ENV=development
SECRET_KEY=change-me-in-production
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
PUBLIC_BACKEND_URL=https://spinster-magma-promptly.ngrok-free.dev
PUBLIC_FRONTEND_URL=http://127.0.0.1:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage
DATABASE_URL=
UPLOAD_DIR=./data/uploads
TRANSCRIPT_DIR=./data/transcripts

# Papa Reo (Te Hiku Media)
PAPAREO_API_KEY=
PAPAREO_BASE_URL=https://api.papareo.io
PAPAREO_TRANSCRIBE_PATH=/tuhi/transcribe
PAPAREO_CREATE_SESSION_PATH=/tuhi/create_session
PAPAREO_MODE=streaming
PAPAREO_STREAM_ENCODING=pcm
PAPAREO_STREAM_SAMPLE_RATE=16000
PAPAREO_STREAM_CHANNELS=1
PAPAREO_STREAM_CHUNK_BYTES=3200
PAPAREO_STREAM_PACE_REALTIME=true

# Zoom OAuth app (assume credentials are available)

ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=https://spinster-magma-promptly.ngrok-free.dev/api/zoom/oauth/callback
ZOOM_WEBHOOK_SECRET_TOKEN=
ZOOM_RTMS_ENABLED=true
ZOOM_AUTO_START_RTMS_ON_MEETING_STARTED=true
ZOOM_TOKEN_ENCRYPTION_KEY=

# Mock RTMS (local audio -> chunked Standard API for realtime-like UI)
MOCK_RTMS_ENABLED=true
MOCK_RTMS_CHUNK_SECONDS=20
MOCK_RTMS_REALTIME_DELAY=false

# Speech processing
VAD_ENABLED=false
MAX_STANDARD_AUDIO_SECONDS=300
DEFAULT_CHUNK_SECONDS=240
PROGRESSIVE_CHUNK_SECONDS=20
PROGRESSIVE_DELAY_SECONDS=0.35


POSTGRES_DB=kaituhi_korero
POSTGRES_USER=kaituhi_app
POSTGRES_PASSWORD=
